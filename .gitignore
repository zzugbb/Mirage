# Local-only context and workspaces
.local/
.scratch/
.private/
assets/source/
assets/restricted/
assets/incoming/

# Ignore unreviewed model files outside the public asset tree
*.blend
*.blend1
*.blend2
*.glb
*.gltf
*.fbx
*.obj
*.mtl
*.stl
*.step
*.stp
*.3ds
*.usd
*.usda
*.usdc
*.usdz
*.max
*.c4d
*.psd
*.psb
*.ai
*.exr
*.hdr

# Reviewed public assets are versioned normally; the manifest check still applies
!assets/public/**

# Secrets and captured field material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.har
*.pcap
*.pcapng
*.log
*.dump
*.sql
*.sqlite
*.sqlite3
*.db
*.zip
*.7z
*.tar
*.tar.gz

# Generated artifacts and editor state
node_modules/
dist/
build/
coverage/
.cache/
.vite/
playwright-report/
test-results/
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
